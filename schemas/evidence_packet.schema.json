{
  "$defs": {
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "calibrated_at": {
          "format": "date-time",
          "title": "Calibrated At",
          "type": "string"
        },
        "calibration_profile_id": {
          "minLength": 1,
          "title": "Calibration Profile Id",
          "type": "string"
        },
        "profile_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Hash",
          "type": "string"
        },
        "room_conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Conditions"
        }
      },
      "required": [
        "calibration_profile_id",
        "profile_hash",
        "calibrated_at"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "DepthProbabilities": {
      "additionalProperties": false,
      "properties": {
        "far": {
          "maximum": 1,
          "minimum": 0,
          "title": "Far",
          "type": "number"
        },
        "mid": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mid",
          "type": "number"
        },
        "near": {
          "maximum": 1,
          "minimum": 0,
          "title": "Near",
          "type": "number"
        },
        "unknown": {
          "maximum": 1,
          "minimum": 0,
          "title": "Unknown",
          "type": "number"
        }
      },
      "required": [
        "near",
        "mid",
        "far",
        "unknown"
      ],
      "title": "DepthProbabilities",
      "type": "object"
    },
    "DepthZone": {
      "additionalProperties": false,
      "description": "Propagation depth proxy — not metric distance.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "$ref": "#/$defs/DepthProbabilities"
        },
        "state": {
          "enum": [
            "near",
            "mid",
            "far",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "probabilities",
        "state",
        "confidence"
      ],
      "title": "DepthZone",
      "type": "object"
    },
    "EvidenceValue": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "title": "EvidenceValue",
      "type": "object"
    },
    "LinkFeatures": {
      "additionalProperties": false,
      "description": "Per-link feature summaries; arrays never enter agent input.",
      "properties": {
        "amplitude_anomaly_ratio": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Amplitude Anomaly Ratio",
          "type": "number"
        },
        "amplitude_mad": {
          "items": {
            "type": "number"
          },
          "title": "Amplitude Mad",
          "type": "array"
        },
        "amplitude_median": {
          "items": {
            "type": "number"
          },
          "title": "Amplitude Median",
          "type": "array"
        },
        "packet_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Packet Coverage",
          "type": "number"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "robust_variance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Robust Variance",
          "type": "number"
        },
        "shape_correlation_to_baseline": {
          "maximum": 1,
          "minimum": 0,
          "title": "Shape Correlation To Baseline",
          "type": "number"
        },
        "spectral_band_energy": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Spectral Band Energy",
          "type": "object"
        },
        "spectral_entropy": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Spectral Entropy",
          "type": "number"
        },
        "subcarrier_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Subcarrier Coverage",
          "type": "number"
        },
        "temporal_diff_rms": {
          "minimum": 0,
          "title": "Temporal Diff Rms",
          "type": "number"
        },
        "valid_carrier_ratio": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Carrier Ratio",
          "type": "number"
        }
      },
      "required": [
        "packet_coverage",
        "subcarrier_coverage",
        "temporal_diff_rms",
        "shape_correlation_to_baseline"
      ],
      "title": "LinkFeatures",
      "type": "object"
    },
    "MotionSignal": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "state": {
          "enum": [
            "idle",
            "micro_motion",
            "moving",
            "fast_change",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "state",
        "confidence"
      ],
      "title": "MotionSignal",
      "type": "object"
    },
    "OccupancyDensity": {
      "additionalProperties": false,
      "description": "Occupancy/obstruction density proxy — not a person count.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "$ref": "#/$defs/OccupancyProbabilities"
        },
        "state": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "probabilities",
        "state",
        "confidence"
      ],
      "title": "OccupancyDensity",
      "type": "object"
    },
    "OccupancyProbabilities": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "maximum": 1,
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "maximum": 1,
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "medium": {
          "maximum": 1,
          "minimum": 0,
          "title": "Medium",
          "type": "number"
        },
        "unknown": {
          "maximum": 1,
          "minimum": 0,
          "title": "Unknown",
          "type": "number"
        }
      },
      "required": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "title": "OccupancyProbabilities",
      "type": "object"
    },
    "QualitySummary": {
      "additionalProperties": false,
      "properties": {
        "link_health": {
          "additionalProperties": {
            "enum": [
              "ok",
              "degraded",
              "stale",
              "error"
            ],
            "type": "string"
          },
          "title": "Link Health",
          "type": "object"
        },
        "overall_status": {
          "enum": [
            "ok",
            "degraded",
            "insufficient_signal",
            "uncalibrated"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "packet_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Packet Coverage",
          "type": "number"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "overall_status",
        "packet_coverage",
        "link_health"
      ],
      "title": "QualitySummary",
      "type": "object"
    },
    "SignalTriplet": {
      "$id": "https://wifi-spatial-council.local/schemas/signal_triplet.schema.json",
      "additionalProperties": false,
      "description": "The three calibrated proxies plus the sensor confidence cap.",
      "properties": {
        "depth_zone": {
          "$ref": "#/$defs/DepthZone"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "motion": {
          "$ref": "#/$defs/MotionSignal"
        },
        "occupancy_density": {
          "$ref": "#/$defs/OccupancyDensity"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_confidence_cap": {
          "maximum": 1,
          "minimum": 0,
          "title": "Sensor Confidence Cap",
          "type": "number"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "mock",
            "replay",
            "live"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "insufficient_signal",
            "uncalibrated"
          ],
          "title": "Status",
          "type": "string"
        },
        "window_id": {
          "minLength": 1,
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "window_id",
        "source_mode",
        "started_at",
        "ended_at",
        "motion",
        "occupancy_density",
        "depth_zone",
        "sensor_confidence_cap",
        "evidence_refs",
        "status"
      ],
      "title": "SignalTriplet",
      "type": "object"
    },
    "SourceManifest": {
      "$id": "https://wifi-spatial-council.local/schemas/source_manifest.schema.json",
      "additionalProperties": false,
      "description": "Identifies where a session's data came from and under what topology.",
      "properties": {
        "firmware_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Firmware Versions",
          "type": "object"
        },
        "link_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Link Ids",
          "type": "array"
        },
        "replay_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Ref"
        },
        "schema_version": {
          "const": "wifi-source.v1",
          "default": "wifi-source.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "session_started_at": {
          "format": "date-time",
          "title": "Session Started At",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "mock",
            "replay",
            "live"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "topology_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Topology Hash",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "source_mode",
        "session_started_at",
        "link_ids",
        "topology_hash"
      ],
      "title": "SourceManifest",
      "type": "object"
    },
    "TopologySummary": {
      "additionalProperties": false,
      "properties": {
        "degraded_links": {
          "items": {
            "type": "string"
          },
          "title": "Degraded Links",
          "type": "array"
        },
        "depth_output_allowed": {
          "title": "Depth Output Allowed",
          "type": "boolean"
        },
        "link_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Link Ids",
          "type": "array"
        },
        "topology_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Topology Hash",
          "type": "string"
        }
      },
      "required": [
        "topology_hash",
        "link_ids",
        "depth_output_allowed"
      ],
      "title": "TopologySummary",
      "type": "object"
    },
    "WindowSummary": {
      "additionalProperties": false,
      "properties": {
        "end_ns": {
          "minimum": 0,
          "title": "End Ns",
          "type": "integer"
        },
        "links": {
          "additionalProperties": {
            "$ref": "#/$defs/LinkFeatures"
          },
          "title": "Links",
          "type": "object"
        },
        "paired_packet_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Paired Packet Coverage",
          "type": "number"
        },
        "start_ns": {
          "minimum": 0,
          "title": "Start Ns",
          "type": "integer"
        },
        "stride_ms": {
          "minimum": 1,
          "title": "Stride Ms",
          "type": "integer"
        },
        "window_id": {
          "minLength": 1,
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "start_ns",
        "end_ns",
        "stride_ms",
        "links",
        "paired_packet_coverage"
      ],
      "title": "WindowSummary",
      "type": "object"
    }
  },
  "$id": "https://wifi-spatial-council.local/schemas/evidence_packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One sealed snapshot of a single analysis cycle; immutable once hashed.",
  "properties": {
    "calibration": {
      "$ref": "#/$defs/CalibrationSummary"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Hash",
      "type": "string"
    },
    "evidence_index": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceValue"
      },
      "title": "Evidence Index",
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/QualitySummary"
    },
    "raw_ref": {
      "minLength": 1,
      "title": "Raw Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "wifi-evidence.v1",
      "default": "wifi-evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "signals": {
      "$ref": "#/$defs/SignalTriplet"
    },
    "source_manifest": {
      "$ref": "#/$defs/SourceManifest"
    },
    "topology": {
      "$ref": "#/$defs/TopologySummary"
    },
    "window_summary": {
      "$ref": "#/$defs/WindowSummary"
    }
  },
  "required": [
    "session_id",
    "cycle_id",
    "sequence",
    "captured_at",
    "source_manifest",
    "window_summary",
    "topology",
    "calibration",
    "quality",
    "signals",
    "evidence_index",
    "raw_ref",
    "evidence_hash"
  ],
  "title": "EvidencePacket",
  "type": "object"
}
