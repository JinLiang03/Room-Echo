    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "simulated-care-scenario.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_moment": {
      "enum": [
        "routine",
        "bathroom_timeout",
        "fall_drill",
        "pet_night"
      ],
      "title": "Selected Moment",
      "type": "string"
    },
    "simulation_only": {
      "const": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "source_mode": {
      "const": "mock",
      "title": "Source Mode",
      "type": "string"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/SimulatedActivityEntry"
      },
      "minItems": 1,
      "title": "Timeline",
      "type": "array"
    },
    "truth_boundary": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Truth Boundary",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "simulation_only",
    "source_mode",
    "device_execution_enabled",
    "resident",
    "home",
    "day_started_at",
    "day_ended_at",
    "timeline",
    "moments",
    "selected_moment",
    "current_index",
    "truth_boundary",
    "generated_at"
  ],
  "title": "SimulatedCareScenario",
  "type": "object"
}
