# CSI receiver: binary frames on UART, console disabled to keep the binary
# stream clean (status/data are separate frame types; no log lines on UART).
CONFIG_PARTITION_TABLE_OFFSET=0xa000
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_FREERTOS_HZ=1000

# Deploy-time tuning (menuconfig overrides these).
CONFIG_WSC_RX_CHANNEL=6
CONFIG_WSC_RX_ID=1
CONFIG_WSC_TX_MAC_0=0x1a
CONFIG_WSC_TX_MAC_1=0x00
CONFIG_WSC_TX_MAC_2=0x00
CONFIG_WSC_TX_MAC_3=0x00
CONFIG_WSC_TX_MAC_4=0x00
CONFIG_WSC_TX_MAC_5=0x00
CONFIG_WSC_SERIAL_BAUD=921600
CONFIG_WSC_SERIAL_UART=0
CONFIG_WSC_SERIAL_TX_GPIO=43
CONFIG_WSC_SERIAL_TX_BUF_SIZE=4096
CONFIG_WSC_CSI_SLOTS=16
# Reproducible builds: do not embed the compile date/time in the app image.
CONFIG_APP_COMPILE_TIME_DATE=n
