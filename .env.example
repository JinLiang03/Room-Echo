APP_MODE=replay
SCENARIO=walk_through
DEMO_AUTOSTART=0
# Presentation-only repeat; accepted for replay/mock and rejected for live.
DEMO_LOOP=0
# Competition/public deployment: same-origin UI + fixed, read-only Replay.
SERVE_WEB=0
PUBLIC_REPLAY=0
OPENAI_API_KEY=
AGENT_PROVIDER=mock
AGENT_COUNCIL_MODEL=gpt-4o-mini
# One cached real Council cycle for POST /api/agent/invoke and MCP invoke_room_echo.
# Keep the continuous Replay provider mock to avoid an unbounded model-call loop.
PUBLIC_OPENAI_INVOKE=0
OPENAI_COUNCIL_DEADLINE_S=120
# Provider-neutral one-shot path. These supersede the two compatibility names
# above when set; never expose the key to Vite or browser variables.
PUBLIC_REAL_PROVIDER_INVOKE=0
REAL_AGENT_PROVIDER=deepseek
REAL_COUNCIL_DEADLINE_S=120
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_COUNCIL_MODEL=deepseek-v4-flash
# Runtime live source; both roles are required and never auto-detected.
RX_PORTS=rx-a=/dev/cu.usbmodemRXA,rx-b=/dev/cu.usbmodemRXB
# Flashing/validation uses TX_PORT plus the explicit RX ports above.
TX_PORT=/dev/cu.usbmodemTX
LIVE_TOPOLOGY_HASH=
CALIBRATION_PROFILE=data/calibration/live_room_v1/profile.json
