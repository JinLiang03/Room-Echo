  "$id": "https://wifi-spatial-council.local/schemas/council_cycle_detail.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full auditable record of one council cycle (API view).",
  "properties": {
    "calls": {
      "items": {
        "$ref": "#/$defs/CouncilCallRecord"
      },
      "title": "Calls",
      "type": "array"
    },
    "challenges": {
      "items": {
        "$ref": "#/$defs/AgentChallenge"
      },
      "title": "Challenges",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AgentClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "deadline_s": {
      "minimum": 0,
      "title": "Deadline S",
      "type": "number"
    },
    "evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Hash",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "phase": {
      "enum": [
        "seal",
        "gate",
        "propose",
        "cross_examine",
        "respond",
        "policy",
        "synthesize",
        "commit"
      ],
      "title": "Phase",
      "type": "string"
    },
    "rejections": {
      "items": {
        "$ref": "#/$defs/PolicyRejection"
      },
      "title": "Rejections",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CouncilResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "council-cycle.v1",
      "default": "council-cycle.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "ambiguous",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "cycle_id",
    "evidence_hash",
    "status",
    "phase",
    "started_at",
    "finished_at",
    "deadline_s"
  ],
  "title": "CouncilCycleDetail",
  "type": "object"
}
