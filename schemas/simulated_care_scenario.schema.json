  "$id": "https://wifi-spatial-council.local/schemas/simulated_care_scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full deterministic 24-hour care demo with one selected UI moment.",
  "properties": {
    "current_index": {
      "maximum": 3,
      "minimum": 0,
      "title": "Current Index",
      "type": "integer"
    },
    "day_ended_at": {
      "format": "date-time",
      "title": "Day Ended At",
      "type": "string"
    },
    "day_started_at": {
