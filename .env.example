APP_MODE=replay
SCENARIO=walk_through
DEMO_AUTOSTART=0
# Presentation-only repeat; accepted for replay/mock and rejected for live.
DEMO_LOOP=0
OPENAI_API_KEY=
AGENT_PROVIDER=mock
AGENT_COUNCIL_MODEL=gpt-4o-mini
# Runtime live source; both roles are required and never auto-detected.
RX_PORTS=rx-a=/dev/cu.usbmodemRXA,rx-b=/dev/cu.usbmodemRXB
# Flashing/validation uses TX_PORT plus the explicit RX ports above.
TX_PORT=/dev/cu.usbmodemTX
LIVE_TOPOLOGY_HASH=
CALIBRATION_PROFILE=data/calibration/live_room_v1/profile.json
